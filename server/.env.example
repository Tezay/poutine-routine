# Server
PORT=8080
CLIENT_ORIGIN=http://localhost:5173
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-with-a-long-random-text

# Database. These values are used by docker-compose.yml.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=poutine_routine
DB_USER=poutine
DB_PASSWORD=poutine
# Only used by docker-compose.yml
DB_ROOT_PASSWORD=root
